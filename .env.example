# Copier en `.env` et remplir. Aucune de ces variables n'a de valeur par defaut :
# une variable manquante fait echouer l'app au runtime, pas au build.

# --- Base de donnees ---------------------------------------------------------
# Lue par prisma/schema.prisma
DATABASE_URL="postgresql://user:password@localhost:5432/tasktrek"

# --- NextAuth ----------------------------------------------------------------
# Lues implicitement par NextAuth (pas de reference process.env dans le code)
# NEXTAUTH_SECRET: generer avec `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth Google ------------------------------------------------------------
# Seul provider: le calendrier repose sur les tokens OAuth Google stockes dans
# Account. Un utilisateur inscrit autrement n'aurait pas de calendrier.
# console.cloud.google.com > APIs & Services > Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=""

# --- Stripe ------------------------------------------------------------------
STRIPE_KEY_SECRET="sk_test_..."

# Signature du webhook. En local: `stripe listen --forward-to
# localhost:3000/api/webhook/stripe` affiche le secret a utiliser.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ID des Price Stripe (PAS les montants: un Price est immuable cote Stripe,
# changer un tarif = creer un nouveau Price et remplacer l'ID ici).
# Premium mensuel — 15,99 EUR / mois
STRIPE_PRICE_ID_MONTHLY="price_..."
# Premium annuel — 159,90 EUR / an (2 mois offerts)
STRIPE_PRICE_ID_YEARLY="price_..."

# --- Divers ------------------------------------------------------------------
# Base des URLs de retour Stripe (success / cancel / portail client)
NEXT_PUBLIC_DOMAIN_URL="http://localhost:3000"
